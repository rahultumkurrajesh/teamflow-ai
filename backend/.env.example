# Copy to .env for local development. Never commit the real .env.
ENVIRONMENT=development
DEBUG=true

POSTGRES_USER=teamflow
POSTGRES_PASSWORD=teamflow
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=teamflow

REDIS_HOST=redis
REDIS_PORT=6379

# S3/MinIO Storage (MinIO for local dev, real S3 for production)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=teamflow
S3_REGION=us-east-1

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
